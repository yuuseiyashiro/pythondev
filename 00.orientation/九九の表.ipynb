   "source": [
    "#@title 九九のリストを作成する\n",
    "list = [[(v*h)for h in range(1, 10)] for v in range(1, 10)]\n",
    "#@title 九九の表を表示する\n",
    "for list_1d in list:\n",
    "    for i in list_1d:\n",
    "        print(f\"{i:3d}\", end=\" \")\n",
    "    print()\n"
